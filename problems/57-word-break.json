{
  "id": 57,
  "slug": "word-break",
  "title": "Word Break",
  "difficulty": "Medium",
  "topic": "1-D Dynamic Programming",
  "leetcodeUrl": "https://leetcode.com/problems/word-break/",
  "videoUrl": null,
  "description": "Given a string `s` and a list of words `wordDict`, return `true` if `s` can be split into one or more dictionary words placed one after another. A word from the dictionary may be used any number of times.",
  "examples": [
    {
      "input": "s = \"leetcode\", wordDict = [\"leet\", \"code\"]",
      "output": "true",
      "explanation": "\"leet\" + \"code\"."
    },
    {
      "input": "s = \"applepenapple\", wordDict = [\"apple\", \"pen\"]",
      "output": "true",
      "explanation": "\"apple\" + \"pen\" + \"apple\"."
    },
    {
      "input": "s = \"catsandog\", wordDict = [\"cats\", \"dog\", \"sand\", \"and\", \"cat\"]",
      "output": "false"
    }
  ],
  "constraints": [
    "1 <= s.length <= 300",
    "1 <= wordDict.length <= 1000",
    "1 <= wordDict[i].length <= 20",
    "All words are distinct lowercase strings"
  ],
  "topics": [
    "String",
    "Dynamic Programming",
    "Hash Set"
  ],
  "complexity": {
    "time": "O(n * L)",
    "space": "O(n + total word length)"
  },
  "hints": [
    "Trying every split point recursively revisits the same suffixes many times.",
    "Let dp[i] mean the first i characters can be segmented. When is dp[i] true given smaller indices?",
    "dp[i] is true if some j < i has dp[j] true and s[j:i] is in the dictionary. Words are at most 20 long, so you only need to look back that far."
  ],
  "kind": "function",
  "className": "Solution",
  "methodName": "wordBreak",
  "params": [
