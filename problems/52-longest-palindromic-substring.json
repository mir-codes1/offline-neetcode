  "validator": "def validate(args, got):\n    s = args[0]\n    if not isinstance(got, str) or not got or got not in s or got != got[::-1]:\n        return False\n    best = 0\n    n = len(s)\n    for c in range(2 * n - 1):\n        l, r = c // 2, c // 2 + c % 2\n        while l >= 0 and r < n and s[l] == s[r]:\n            l -= 1\n            r += 1\n        best = max(best, r - l - 1)\n    return len(got) == best",
